# Copia a .env y completa. NUNCA commitear .env

# Entorno: development | paper | production
ATLAS_ENV=development

# PostgreSQL
ATLAS_POSTGRES_HOST=localhost
ATLAS_POSTGRES_PORT=5432
ATLAS_POSTGRES_DB=atlas
ATLAS_POSTGRES_USER=atlas
ATLAS_POSTGRES_PASSWORD=change_me_dev_only

